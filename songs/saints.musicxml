  <work><work-title>聖者の行進</work-title></work>
  <identification><creator type="composer">Traditional（黒人霊歌）</creator><miscellaneous><miscellaneous-field name="source">ルイ・アームストロング（1938 年）で有名なニューオーリンズ・ジャズの定番。メロディはトランペット、伴奏はチューバの低音とピアノの和音の 2 ビート。♩=100。右手はド〜ソの基本位置のまま</miscellaneous-field></miscellaneous></identification>
  <part-list>
    <score-part id="P1"><part-name>トランペット</part-name></score-part>
    <score-part id="P2"><part-name>チューバ・ピアノ</part-name></score-part>
  </part-list>
