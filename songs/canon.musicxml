<score-partwise version="4.0">
  <work><work-title>カノン</work-title></work>
  <identification><creator type="composer">Johann Pachelbel</creator><miscellaneous><miscellaneous-field name="source">第 1 ヴァイオリンの最初の 3 つの旋律（4 分音符・4 分音符・8 分音符の動き）と終わりの形。原曲は 3 つのヴァイオリンと通奏低音。伴奏は通奏低音（チェロの低音＋チェンバロの和音）を最小限に。♩=66</miscellaneous-field></miscellaneous></identification>
  <part-list>
    <score-part id="P1"><part-name>ヴァイオリン</part-name></score-part>
    <score-part id="P2"><part-name>通奏低音（チェロ・チェンバロ）</part-name></score-part>
  </part-list>
